rules_version = '2';

// Security model
// - The admin panel is private: ONLY the owner account(s) below can write anything, and
//   only they can read the private document (hidden events + remaining-time timer).
//   Any other Google account that signs in gets nothing.
// - The overlay needs no login: anyone can *get* a public subathon document by its id
//   (the id is in the OBS URL). Listing / enumerating documents is not allowed.
// - Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    // Firebase Auth UIDs allowed to use the panel. Add more only if you trust them fully.
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.uid in ['1tFeYdWdHnhqb7qj9kSo8C5V5yS2'];
    }

    match /subathons/{uid} {
      allow get: if true;
      allow write: if isOwner(uid);

      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
